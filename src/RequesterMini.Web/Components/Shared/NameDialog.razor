@* Asks for a name and hands it to Commit. The rule lives in the store, not here: this dialog used
   to re-check uniqueness against a list it was passed, which meant the same rule in two places and
   only the copy here was ever shown to the user. Now it shows whatever the store reports. *@

<MudDialog>
    <DialogContent>
        <MudTextField T="string" @bind-Value="_name" Label="@Label" Variant="Variant.Outlined"
                      Immediate="true" AutoFocus="true" OnKeyUp="OnKeyUp"
                      Error="@(_error is not null)" ErrorText="@_error" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
                   Disabled="@string.IsNullOrWhiteSpace(_name)">
            Create
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;

    /// <summary>
    /// Performs the creation. The dialog closes on success and stays open showing the reason on
    /// failure, so the user can correct the name without retyping it.
    /// </summary>
    [Parameter, EditorRequired] public Func<string, Result> Commit { get; set; } = null!;

    [Parameter] public string Label { get; set; } = "Name";

    private string _name = "";
    private string? _error;

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;

        var result = Commit(_name);
        if (result.IsFailed)
        {
            _error = string.Join(" ", result.Errors.Select(e => e.Message));
            return;
        }

        Dialog.Close(DialogResult.Ok(_name.Trim()));
    }

    private void OnKeyUp(KeyboardEventArgs args)
    {
        if (args.Key is "Enter") Submit();
    }

    private void Cancel() => Dialog.Cancel();
}
